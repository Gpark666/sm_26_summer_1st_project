# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=sm_accessguard

# 또는 직접 SQLAlchemy DATABASE_URL 지정
# MySQL: mysql+pymysql://root:your_password_here@localhost:3306/sm_accessguard?charset=utf8mb4
# SQLite (로컬 테스트용): sqlite:///./app.db
DATABASE_URL=sqlite:///./app.db

# DB Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=False
